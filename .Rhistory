# Generates realistic conjoint ratings across 3 latent segments
# with monotonic utility patterns:
#   Channels:  50 < 100 < 200 < 300
#   Movie:     None < HBO < HBO+ShowTime
#   DVR:       None < SD DVR < HD DVR
#   Price:     $30 > $60 > $90 > $120 > $150 > $200
#   Internet:  None < 100 Mbps < 300 Mbps
#   Phone:     None < 200 Mins < Unlimited
#
# Strategy: oversample (204 respondents), run OLS + segmentation,
# then DROP individuals that don't fall into the 3 largest
# segments. This guarantees exactly 3 clean segments in the
# final CSV.
# ============================================================
set.seed(1)
# --- 1. Read the dummy-coded design matrix ---
design <- read.csv("conjoint_design.csv")
X <- as.matrix(design[, -1])  # drop Profile column
n_profiles <- nrow(X)
n_dummies  <- ncol(X)
cat("Design matrix:", n_profiles, "profiles x", n_dummies, "dummies\n")
# --- 2. Define RAW (unscaled) segment betas ---
# Column order (16 dummies):
#   Ch_100, Ch_200, Ch_300,
#   Mov_HBO, Mov_HBO+ST,
#   DVR_SD, DVR_HD,
#   Pr_60, Pr_90, Pr_120, Pr_150, Pr_200,
#   Int_100, Int_300,
#   Ph_200, Ph_Unl
# Segment 1: "Channels, Internet" — a little price sensitive (~22%)
# Price sensitivity: less than Seg3 (42%), more than Seg2 (11%)
seg1_raw <- c(13, 17, 19,             # Channels range=19
1, 2,                     # Movie range=2
0.5, 1,                   # DVR range=1
-2, -5, -7, -10, -12,   # Price range=12 (~22% imp)
15, 20,                   # Internet range=20
0.5, 1)                   # Phone range=1
# Segment 2: "Channels, Movie, Internet" — least price sensitive (~11%)
seg2_raw <- c(7, 14, 22,              # Channels range=22
17, 18,                   # Movie range=18
1.5, 3,                   # DVR range=3
-1, -3, -5, -6, -8,     # Price range=8 (~11% imp)
8, 19,                    # Internet range=19
0.25, 0.5)               # Phone range=0.5
# Segment 3: "Tech Focused"
seg3_raw <- c(1.5, 2.5, 4,            # Channels
0.5, 1,                   # Movie
1, 2,                     # DVR
-4, -8, -13, -18, -24,  # Price
16, 25,                   # Internet
0.5, 1.5)                # Phone
raw_betas     <- list(seg1_raw, seg2_raw, seg3_raw)
segment_names <- c("Price Sensitive", "Entertainment Lover", "Tech Focused")
seg_sizes     <- c(69, 55, 80)   # oversample — will filter later
# --- 3. Auto-scale betas so ratings span [5, 95] ---
segment_betas      <- list()
segment_intercepts <- numeric(3)
cat("\n--- Auto-scaling betas ---\n")
for (s in 1:3) {
u <- as.numeric(X %*% raw_betas[[s]])
u_min <- min(u);  u_max <- max(u)
scale_factor <- 90 / (u_max - u_min)
segment_betas[[s]] <- raw_betas[[s]] * scale_factor
segment_intercepts[s] <- 50 - (u_max + u_min) * scale_factor / 2
cat(sprintf("  %-22s  scale=%.3f  intercept=%.1f  rating=[%.1f, %.1f]\n",
segment_names[s], scale_factor, segment_intercepts[s],
segment_intercepts[s] + min(u) * scale_factor,
segment_intercepts[s] + max(u) * scale_factor))
}
# --- 4. Print importance ratios (pre-noise) ---
cat("\n--- Target importance ratios ---\n")
attr_names   <- c("Channels", "Movie", "DVR", "Price", "Internet", "Phone")
attr_indices <- list(1:3, 4:5, 6:7, 8:12, 13:14, 15:16)
attr_sizes   <- c(3, 2, 2, 5, 2, 2)
n_attrs      <- length(attr_sizes)
for (s in 1:3) {
b <- segment_betas[[s]]
ranges <- sapply(attr_indices, function(idx) {
vals <- c(0, b[idx])
max(vals) - min(vals)
})
imp <- ranges / sum(ranges) * 100
cat(sprintf("  %-22s ", segment_names[s]))
cat(paste0(attr_names, "=", round(imp, 1), "%"), sep = "  ")
cat("\n")
}
# --- 5. Simulation parameters ---
n_respondents <- sum(seg_sizes)
noise_sd      <- 5.5
# --- 6. Generate ratings ---
ratings_matrix <- matrix(0, nrow = n_profiles, ncol = n_respondents)
resp_counter   <- 0
for (seg_idx in 1:3) {
seg_beta  <- segment_betas[[seg_idx]]
intercept <- segment_intercepts[seg_idx]
n_seg     <- seg_sizes[seg_idx]
for (i in 1:n_seg) {
resp_counter <- resp_counter + 1
# Per-ATTRIBUTE scaling (sd=0.05): preserves importance ratios
attr_scale <- rnorm(n_attrs, mean = 1, sd = 0.05)
scale_vec  <- rep(attr_scale, attr_sizes)
beta_i     <- seg_beta * scale_vec
# Small per-coefficient noise for within-attribute variation
beta_i <- beta_i * (1 + rnorm(n_dummies, 0, 0.02))
# Enforce monotonicity (safety net)
beta_i[1:3]   <-  sort(abs(beta_i[1:3]))           # Channels up
beta_i[4:5]   <-  sort(abs(beta_i[4:5]))           # Movie up
beta_i[6:7]   <-  sort(abs(beta_i[6:7]))           # DVR up
beta_i[8:12]  <- -sort(abs(beta_i[8:12]))           # Price down
beta_i[13:14] <-  sort(abs(beta_i[13:14]))          # Internet up
beta_i[15:16] <-  sort(abs(beta_i[15:16]))          # Phone up
# Generate ratings: y = intercept + X %*% beta + noise
y <- intercept + as.numeric(X %*% beta_i) + rnorm(n_profiles, 0, noise_sd)
y <- round(y)
y <- pmin(pmax(y, 1), 100)
ratings_matrix[, resp_counter] <- y
}
}
cat("\nGenerated", n_respondents, "respondents (before filtering)\n")
cat("Rating range:", min(ratings_matrix), "-", max(ratings_matrix),
"  mean:", round(mean(ratings_matrix), 1), "\n")
# --- 7. OLS for all respondents ---
cat("\n--- OLS Regression ---\n")
ols_betas  <- matrix(0, nrow = n_respondents, ncol = n_dummies + 1)
r_squared  <- numeric(n_respondents)
for (r in 1:n_respondents) {
y   <- ratings_matrix[, r]
fit <- lm(y ~ X)
ols_betas[r, ] <- coef(fit)
r_squared[r]   <- summary(fit)$r.squared
}
cat("R-squared -- min:", round(min(r_squared), 3),
" mean:", round(mean(r_squared), 3),
" max:", round(max(r_squared), 3), "\n")
# --- 8. Segmentation (all respondents) ---
cat("\n--- Segmentation (all", n_respondents, "respondents, 25% threshold) ---\n")
importance <- matrix(0, nrow = n_respondents, ncol = n_attrs)
for (r in 1:n_respondents) {
pw <- ols_betas[r, -1]
ranges <- sapply(attr_indices, function(idx) {
vals <- c(0, pw[idx])
max(vals) - min(vals)
})
importance[r, ] <- ranges / sum(ranges) * 100
}
threshold  <- 25
seg_labels <- character(n_respondents)
for (r in 1:n_respondents) {
important <- attr_names[importance[r, ] >= threshold]
seg_labels[r] <- paste(important, collapse = ", ")
}
seg_table_all <- sort(table(seg_labels), decreasing = TRUE)
cat(sprintf("Found %d unique segments (before filtering):\n", length(seg_table_all)))
for (i in seq_along(seg_table_all)) {
cat(sprintf("  %-40s %3d respondents (%4.1f%%)\n",
names(seg_table_all)[i],
seg_table_all[i],
seg_table_all[i] / n_respondents * 100))
}
# --- 9. FILTER: keep only the 3 largest segments ---
top3_names <- names(seg_table_all)[1:min(3, length(seg_table_all))]
keep_idx   <- which(seg_labels %in% top3_names)
n_kept     <- length(keep_idx)
n_dropped  <- n_respondents - n_kept
cat(sprintf("\n--- Filtering: keeping top 3 segments ---\n"))
cat(sprintf("  Keeping:  %d respondents in segments: %s\n",
n_kept, paste(top3_names, collapse = " | ")))
cat(sprintf("  Dropping: %d respondents from %d minor segments\n",
n_dropped, length(seg_table_all) - min(3, length(seg_table_all))))
# Filter ratings matrix
ratings_filtered <- ratings_matrix[, keep_idx]
# --- 10. Shuffle respondent order (avoid segment blocks) ---
shuffle_order    <- sample(n_kept)
ratings_filtered <- ratings_filtered[, shuffle_order]
# --- 11. Write the FILTERED + SHUFFLED ratings CSV ---
ratings_df <- data.frame(
Profile = 1:n_profiles,
ratings_filtered
)
colnames(ratings_df) <- c("Profile",
paste0("Respondent_", 1:n_kept))
write.csv(ratings_df, "conjoint_ratings.csv", row.names = FALSE)
cat(sprintf("\nWrote conjoint_ratings.csv: %d profiles x %d respondents\n",
n_profiles, n_kept))
cat("Rating range:", min(ratings_filtered), "-", max(ratings_filtered),
"  mean:", round(mean(ratings_filtered), 1), "\n")
# --- 11. Verify filtered data ---
cat("\n--- Verification (filtered data) ---\n")
# Re-run OLS on kept respondents
ols_betas_f  <- matrix(0, nrow = n_kept, ncol = n_dummies + 1)
r_squared_f  <- numeric(n_kept)
for (r in 1:n_kept) {
y   <- ratings_filtered[, r]
fit <- lm(y ~ X)
ols_betas_f[r, ] <- coef(fit)
r_squared_f[r]   <- summary(fit)$r.squared
}
cat("R-squared -- min:", round(min(r_squared_f), 3),
" mean:", round(mean(r_squared_f), 3),
" max:", round(max(r_squared_f), 3), "\n")
# Average betas
avg_beta    <- colMeans(ols_betas_f)
dummy_names <- colnames(X)
cat("\nAverage part-worth utilities:\n")
cat("  Intercept:", round(avg_beta[1], 2), "\n")
for (j in 1:n_dummies) {
cat(sprintf("  %-40s %+.2f\n", dummy_names[j], avg_beta[j + 1]))
}
# Monotonicity
cat("\nMonotonicity:\n")
b <- avg_beta[-1]
cat("  Channels:  ", round(b[1],1), "<", round(b[2],1), "<", round(b[3],1),
"?", b[1] < b[2] && b[2] < b[3], "\n")
cat("  Movie:     ", round(b[4],1), "<", round(b[5],1),
"?", b[4] < b[5], "\n")
cat("  DVR:       ", round(b[6],1), "<", round(b[7],1),
"?", b[6] < b[7], "\n")
cat("  Price:     ", round(b[8],1), ">", round(b[9],1), ">", round(b[10],1),
">", round(b[11],1), ">", round(b[12],1),
"?", b[8] > b[9] && b[9] > b[10] && b[10] > b[11] && b[11] > b[12], "\n")
cat("  Internet:  ", round(b[13],1), "<", round(b[14],1),
"?", b[13] < b[14], "\n")
cat("  Phone:     ", round(b[15],1), "<", round(b[16],1),
"?", b[15] < b[16], "\n")
# Final segmentation verification
cat("\n--- Final Segmentation (filtered data, 25% threshold) ---\n")
importance_f <- matrix(0, nrow = n_kept, ncol = n_attrs)
for (r in 1:n_kept) {
pw <- ols_betas_f[r, -1]
ranges <- sapply(attr_indices, function(idx) {
vals <- c(0, pw[idx])
max(vals) - min(vals)
})
importance_f[r, ] <- ranges / sum(ranges) * 100
}
seg_labels_f <- character(n_kept)
for (r in 1:n_kept) {
important <- attr_names[importance_f[r, ] >= threshold]
seg_labels_f[r] <- paste(important, collapse = ", ")
}
seg_table_f <- sort(table(seg_labels_f), decreasing = TRUE)
cat(sprintf("\nFound %d unique segments:\n", length(seg_table_f)))
for (i in seq_along(seg_table_f)) {
cat(sprintf("  %-40s %3d respondents (%4.1f%%)\n",
names(seg_table_f)[i],
seg_table_f[i],
seg_table_f[i] / n_kept * 100))
}
if (length(seg_table_f) <= 3) {
cat(sprintf("\n  SUCCESS: Exactly %d clean segments!\n", length(seg_table_f)))
} else {
cat(sprintf("\n  WARNING: Still %d segments after filtering.\n", length(seg_table_f)))
}
# ============================================================
# Simulate Conjoint Ratings Data
# ============================================================
# Generates realistic conjoint ratings across 3 latent segments
# with monotonic utility patterns:
#   Channels:  50 < 100 < 200 < 300
#   Movie:     None < HBO < HBO+ShowTime
#   DVR:       None < SD DVR < HD DVR
#   Price:     $30 > $60 > $90 > $120 > $150 > $200
#   Internet:  None < 100 Mbps < 300 Mbps
#   Phone:     None < 200 Mins < Unlimited
#
# Strategy: oversample (204 respondents), run OLS + segmentation,
# then DROP individuals that don't fall into the 3 largest
# segments. This guarantees exactly 3 clean segments in the
# final CSV.
# ============================================================
set.seed(1)
# --- 1. Read the dummy-coded design matrix ---
design <- read.csv("conjoint_design.csv")
X <- as.matrix(design[, -1])  # drop Profile column
n_profiles <- nrow(X)
n_dummies  <- ncol(X)
cat("Design matrix:", n_profiles, "profiles x", n_dummies, "dummies\n")
# --- 2. Define RAW (unscaled) segment betas ---
# Column order (16 dummies):
#   Ch_100, Ch_200, Ch_300,
#   Mov_HBO, Mov_HBO+ST,
#   DVR_SD, DVR_HD,
#   Pr_60, Pr_90, Pr_120, Pr_150, Pr_200,
#   Int_100, Int_300,
#   Ph_200, Ph_Unl
# Segment 1: "Channels, Internet" — a little price sensitive (~22%)
# Price sensitivity: less than Seg3 (42%), more than Seg2 (11%)
seg1_raw <- c(13, 17, 19,             # Channels range=19
1, 2,                     # Movie range=2
0.5, 1,                   # DVR range=1
-2, -5, -7, -10, -12,   # Price range=12 (~22% imp)
15, 20,                   # Internet range=20
0.5, 1)                   # Phone range=1
# Segment 2: "Channels, Movie, Internet" — least price sensitive (~11%)
seg2_raw <- c(7, 14, 22,              # Channels range=22
17, 18,                   # Movie range=18
1.5, 3,                   # DVR range=3
-1, -3, -5, -6, -8,     # Price range=8 (~11% imp)
8, 19,                    # Internet range=19
0.25, 0.5)               # Phone range=0.5
# Segment 3: "Tech Focused"
seg3_raw <- c(1.5, 2.5, 4,            # Channels
0.5, 1,                   # Movie
1, 2,                     # DVR
-4, -8, -13, -18, -24,  # Price
16, 25,                   # Internet
0.5, 1.5)                # Phone
raw_betas     <- list(seg1_raw, seg2_raw, seg3_raw)
segment_names <- c("Price Sensitive", "Entertainment Lover", "Tech Focused")
seg_sizes     <- c(200, 200, 200)   # oversample — will filter later
# --- 3. Auto-scale betas so ratings span [5, 95] ---
segment_betas      <- list()
segment_intercepts <- numeric(3)
cat("\n--- Auto-scaling betas ---\n")
for (s in 1:3) {
u <- as.numeric(X %*% raw_betas[[s]])
u_min <- min(u);  u_max <- max(u)
scale_factor <- 90 / (u_max - u_min)
segment_betas[[s]] <- raw_betas[[s]] * scale_factor
segment_intercepts[s] <- 50 - (u_max + u_min) * scale_factor / 2
cat(sprintf("  %-22s  scale=%.3f  intercept=%.1f  rating=[%.1f, %.1f]\n",
segment_names[s], scale_factor, segment_intercepts[s],
segment_intercepts[s] + min(u) * scale_factor,
segment_intercepts[s] + max(u) * scale_factor))
}
# --- 4. Print importance ratios (pre-noise) ---
cat("\n--- Target importance ratios ---\n")
attr_names   <- c("Channels", "Movie", "DVR", "Price", "Internet", "Phone")
attr_indices <- list(1:3, 4:5, 6:7, 8:12, 13:14, 15:16)
attr_sizes   <- c(3, 2, 2, 5, 2, 2)
n_attrs      <- length(attr_sizes)
for (s in 1:3) {
b <- segment_betas[[s]]
ranges <- sapply(attr_indices, function(idx) {
vals <- c(0, b[idx])
max(vals) - min(vals)
})
imp <- ranges / sum(ranges) * 100
cat(sprintf("  %-22s ", segment_names[s]))
cat(paste0(attr_names, "=", round(imp, 1), "%"), sep = "  ")
cat("\n")
}
# --- 5. Simulation parameters ---
n_respondents <- sum(seg_sizes)
noise_sd      <- 5.5
# --- 6. Generate ratings ---
ratings_matrix <- matrix(0, nrow = n_profiles, ncol = n_respondents)
resp_counter   <- 0
for (seg_idx in 1:3) {
seg_beta  <- segment_betas[[seg_idx]]
intercept <- segment_intercepts[seg_idx]
n_seg     <- seg_sizes[seg_idx]
for (i in 1:n_seg) {
resp_counter <- resp_counter + 1
# Per-ATTRIBUTE scaling (sd=0.05): preserves importance ratios
attr_scale <- rnorm(n_attrs, mean = 1, sd = 0.05)
scale_vec  <- rep(attr_scale, attr_sizes)
beta_i     <- seg_beta * scale_vec
# Small per-coefficient noise for within-attribute variation
beta_i <- beta_i * (1 + rnorm(n_dummies, 0, 0.02))
# Enforce monotonicity (safety net)
beta_i[1:3]   <-  sort(abs(beta_i[1:3]))           # Channels up
beta_i[4:5]   <-  sort(abs(beta_i[4:5]))           # Movie up
beta_i[6:7]   <-  sort(abs(beta_i[6:7]))           # DVR up
beta_i[8:12]  <- -sort(abs(beta_i[8:12]))           # Price down
beta_i[13:14] <-  sort(abs(beta_i[13:14]))          # Internet up
beta_i[15:16] <-  sort(abs(beta_i[15:16]))          # Phone up
# Generate ratings: y = intercept + X %*% beta + noise
y <- intercept + as.numeric(X %*% beta_i) + rnorm(n_profiles, 0, noise_sd)
y <- round(y)
y <- pmin(pmax(y, 1), 100)
ratings_matrix[, resp_counter] <- y
}
}
cat("\nGenerated", n_respondents, "respondents (before filtering)\n")
cat("Rating range:", min(ratings_matrix), "-", max(ratings_matrix),
"  mean:", round(mean(ratings_matrix), 1), "\n")
# --- 7. OLS for all respondents ---
cat("\n--- OLS Regression ---\n")
ols_betas  <- matrix(0, nrow = n_respondents, ncol = n_dummies + 1)
r_squared  <- numeric(n_respondents)
for (r in 1:n_respondents) {
y   <- ratings_matrix[, r]
fit <- lm(y ~ X)
ols_betas[r, ] <- coef(fit)
r_squared[r]   <- summary(fit)$r.squared
}
cat("R-squared -- min:", round(min(r_squared), 3),
" mean:", round(mean(r_squared), 3),
" max:", round(max(r_squared), 3), "\n")
# --- 8. Segmentation (all respondents) ---
cat("\n--- Segmentation (all", n_respondents, "respondents, 25% threshold) ---\n")
importance <- matrix(0, nrow = n_respondents, ncol = n_attrs)
for (r in 1:n_respondents) {
pw <- ols_betas[r, -1]
ranges <- sapply(attr_indices, function(idx) {
vals <- c(0, pw[idx])
max(vals) - min(vals)
})
importance[r, ] <- ranges / sum(ranges) * 100
}
threshold  <- 25
seg_labels <- character(n_respondents)
for (r in 1:n_respondents) {
important <- attr_names[importance[r, ] >= threshold]
seg_labels[r] <- paste(important, collapse = ", ")
}
seg_table_all <- sort(table(seg_labels), decreasing = TRUE)
cat(sprintf("Found %d unique segments (before filtering):\n", length(seg_table_all)))
for (i in seq_along(seg_table_all)) {
cat(sprintf("  %-40s %3d respondents (%4.1f%%)\n",
names(seg_table_all)[i],
seg_table_all[i],
seg_table_all[i] / n_respondents * 100))
}
# --- 9. FILTER: keep only the 3 largest segments ---
top3_names <- names(seg_table_all)[1:min(3, length(seg_table_all))]
keep_idx   <- which(seg_labels %in% top3_names)
n_kept     <- length(keep_idx)
n_dropped  <- n_respondents - n_kept
cat(sprintf("\n--- Filtering: keeping top 3 segments ---\n"))
cat(sprintf("  Keeping:  %d respondents in segments: %s\n",
n_kept, paste(top3_names, collapse = " | ")))
cat(sprintf("  Dropping: %d respondents from %d minor segments\n",
n_dropped, length(seg_table_all) - min(3, length(seg_table_all))))
# Filter ratings matrix
ratings_filtered <- ratings_matrix[, keep_idx]
# --- 10. Shuffle respondent order (avoid segment blocks) ---
shuffle_order    <- sample(n_kept)
ratings_filtered <- ratings_filtered[, shuffle_order]
# --- 11. Write the FILTERED + SHUFFLED ratings CSV ---
ratings_df <- data.frame(
Profile = 1:n_profiles,
ratings_filtered
)
colnames(ratings_df) <- c("Profile",
paste0("Respondent_", 1:n_kept))
write.csv(ratings_df, "conjoint_ratings.csv", row.names = FALSE)
cat(sprintf("\nWrote conjoint_ratings.csv: %d profiles x %d respondents\n",
n_profiles, n_kept))
cat("Rating range:", min(ratings_filtered), "-", max(ratings_filtered),
"  mean:", round(mean(ratings_filtered), 1), "\n")
# --- 11. Verify filtered data ---
cat("\n--- Verification (filtered data) ---\n")
# Re-run OLS on kept respondents
ols_betas_f  <- matrix(0, nrow = n_kept, ncol = n_dummies + 1)
r_squared_f  <- numeric(n_kept)
for (r in 1:n_kept) {
y   <- ratings_filtered[, r]
fit <- lm(y ~ X)
ols_betas_f[r, ] <- coef(fit)
r_squared_f[r]   <- summary(fit)$r.squared
}
cat("R-squared -- min:", round(min(r_squared_f), 3),
" mean:", round(mean(r_squared_f), 3),
" max:", round(max(r_squared_f), 3), "\n")
# Average betas
avg_beta    <- colMeans(ols_betas_f)
dummy_names <- colnames(X)
cat("\nAverage part-worth utilities:\n")
cat("  Intercept:", round(avg_beta[1], 2), "\n")
for (j in 1:n_dummies) {
cat(sprintf("  %-40s %+.2f\n", dummy_names[j], avg_beta[j + 1]))
}
# Monotonicity
cat("\nMonotonicity:\n")
b <- avg_beta[-1]
cat("  Channels:  ", round(b[1],1), "<", round(b[2],1), "<", round(b[3],1),
"?", b[1] < b[2] && b[2] < b[3], "\n")
cat("  Movie:     ", round(b[4],1), "<", round(b[5],1),
"?", b[4] < b[5], "\n")
cat("  DVR:       ", round(b[6],1), "<", round(b[7],1),
"?", b[6] < b[7], "\n")
cat("  Price:     ", round(b[8],1), ">", round(b[9],1), ">", round(b[10],1),
">", round(b[11],1), ">", round(b[12],1),
"?", b[8] > b[9] && b[9] > b[10] && b[10] > b[11] && b[11] > b[12], "\n")
cat("  Internet:  ", round(b[13],1), "<", round(b[14],1),
"?", b[13] < b[14], "\n")
cat("  Phone:     ", round(b[15],1), "<", round(b[16],1),
"?", b[15] < b[16], "\n")
# Final segmentation verification
cat("\n--- Final Segmentation (filtered data, 25% threshold) ---\n")
importance_f <- matrix(0, nrow = n_kept, ncol = n_attrs)
for (r in 1:n_kept) {
pw <- ols_betas_f[r, -1]
ranges <- sapply(attr_indices, function(idx) {
vals <- c(0, pw[idx])
max(vals) - min(vals)
})
importance_f[r, ] <- ranges / sum(ranges) * 100
}
seg_labels_f <- character(n_kept)
for (r in 1:n_kept) {
important <- attr_names[importance_f[r, ] >= threshold]
seg_labels_f[r] <- paste(important, collapse = ", ")
}
seg_table_f <- sort(table(seg_labels_f), decreasing = TRUE)
cat(sprintf("\nFound %d unique segments:\n", length(seg_table_f)))
for (i in seq_along(seg_table_f)) {
cat(sprintf("  %-40s %3d respondents (%4.1f%%)\n",
names(seg_table_f)[i],
seg_table_f[i],
seg_table_f[i] / n_kept * 100))
}
if (length(seg_table_f) <= 3) {
cat(sprintf("\n  SUCCESS: Exactly %d clean segments!\n", length(seg_table_f)))
} else {
cat(sprintf("\n  WARNING: Still %d segments after filtering.\n", length(seg_table_f)))
}
runif(5, 0, 30)
sum(runif(5, 0, 30))
sum(runif(5, 0, 30))
